{
  "info": {
    "name": "AutoLoc API - Atelier 5",
    "description": "Scenarios CRUD sequentiels pour Agence, Client et Vehicule. Importer dans Postman, demarrer l'API, puis lancer toute la collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Agences - POST creer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/agences",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Agence Postman\",\n  \"ville\": \"Tunis\",\n  \"adresse\": \"Avenue Habib Bourguiba\",\n  \"telephone\": \"71000000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('POST renvoie 200', () => pm.response.to.have.status(200));",
              "const entity = pm.response.json(); pm.expect(entity.idAgence).to.exist;",
              "pm.collectionVariables.set('agenceId', entity.idAgence);"
            ]
          }
        }
      ]
    },
